{
  "name": "hanabi-canvas",
  "version": "0.1.0",
  "description": "光と音に心をほどく、静かな花火のアンビエントキャンバス",
  "author": "Hanabi Canvas",
  "private": true,
  "type": "module",
  "main": "build/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:web && npm run test:audio && npm run test:server",
    "test:web": "vitest run",
    "test:watch": "vitest",
    "test:audio": "node --test scripts/verify-audio-assets.mjs",
    "test:server": "npm test --prefix server",
    "audio:generate": "node scripts/generate-audio.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "tsx electron/main.ts",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --config electron-builder.json",
    "wallpaper:build": "npm run build && tsx scripts/build-wallpaper.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
